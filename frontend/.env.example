# AEGIS frontend configuration
#
# Copy to .env.local for local development. Vite only exposes variables
# prefixed with VITE_.


# Backend base URL. Defaults to the deployed backend when unset, so the
# production build keeps working with no configuration.
VITE_API_BASE_URL=http://127.0.0.1:8000


# Operator credential for control-plane actions — editing policy and toggling
# guardrails. Must match the backend's AEGIS_OPERATOR_TOKEN.
#
# Leave empty against the public demo, whose control plane is open.
VITE_OPERATOR_TOKEN=


# Hide the screens still backed by static fixtures (Analytics, Incident
# Center, Audit Logs, Approval Center).
#
# Worth setting to true before a demo: Analytics computes "Total Spent" from
# mock data, so anyone who runs transactions and then opens it sees numbers
# unrelated to what they just did.
VITE_HIDE_MOCK_SCREENS=false
