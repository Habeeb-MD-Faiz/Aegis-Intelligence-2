# AEGIS backend configuration
#
# Copy to .env and fill in. Never commit the real .env — it is gitignored.
# Every value below is optional; AEGIS runs with none of them set.


# ============================================================
# IDENTITY — control plane / data plane
# ============================================================
#
# Set these to close the two planes to anonymous callers.
#
# The separation is enforced in code regardless: an agent credential is
# rejected on the control plane whether or not these are configured. Setting
# them additionally stops anonymous callers from changing policy, which is
# what you want anywhere the URL is reachable from the internet.

AEGIS_OPERATOR_TOKEN=
AEGIS_AGENT_TOKEN=


# ============================================================
# PROVIDER CREDENTIALS
# ============================================================
#
# The secrets agents are never given. AEGIS injects these itself, after a
# payment has been authorized.
#
# Naming: AEGIS_CREDENTIAL_<PROVIDER>, uppercased, spaces as underscores.

# AEGIS_CREDENTIAL_BLOOMBERG=
# AEGIS_CREDENTIAL_ALPHA_VANTAGE=
# AEGIS_CREDENTIAL_OPENWEATHER=


# ============================================================
# PROVIDER ENDPOINTS
# ============================================================
#
# The URL the guard calls on an agent's behalf. Without one, AEGIS still
# authorizes the payment and injects the credential, but fulfils in simulation
# and reports fulfilment: "simulated" rather than pretending otherwise.
#
# Naming matches the credential vars: AEGIS_ENDPOINT_<PROVIDER>.

# AEGIS_ENDPOINT_BLOOMBERG=https://api.example.com/v1/query
# AEGIS_ENDPOINT_OPENWEATHER=


# ============================================================
# LEDGER ANCHORING (optional)
# ============================================================
#
# With a funded Base Sepolia testnet key, AEGIS writes the ledger's chain head
# on-chain periodically, so local history cannot be rewritten without also
# altering a record we do not control.
#
# Without a key, anchoring is skipped and /config reports anchoringEnabled:
# false. We never claim an anchor we did not write.
#
# This does NOT move funds. It writes a hash. Do not put a mainnet key here.

AEGIS_CHAIN_PRIVATE_KEY=
AEGIS_CHAIN_RPC_URL=https://sepolia.base.org
AEGIS_CHAIN_NAME=Base Sepolia
AEGIS_ANCHOR_EVERY=5


# ============================================================
# POLICY BUILDER (optional)
# ============================================================
#
# Only the policy-suggestion feature needs this. Every other part of AEGIS
# runs without it.

GROQ_API_KEY=
AEGIS_POLICY_MODEL=llama-3.3-70b-versatile


# ============================================================
# HTTP
# ============================================================

# Comma-separated. Defaults to localhost:5173 plus the deployed frontend.
AEGIS_CORS_ORIGINS=


# ============================================================
# STORAGE
# ============================================================

AEGIS_DB_FILE=aegis.db
AEGIS_LEDGER_FILE=blockchain.json

# Seed historical requests on first boot so a cold dyno is not an empty
# dashboard. Seeded records are dated to previous days, so they never consume
# today's budget or frequency window.
AEGIS_SEED_DEMO_DATA=true


# ============================================================
# GUARD BEHAVIOUR
# ============================================================

AEGIS_GUARD_TIMEOUT=10

# Leave false. If the policy engine errors, refuse rather than allow — a guard
# that opens when its own evaluation crashes is not a guard.
AEGIS_GUARD_FAIL_OPEN=false
